{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Current public website. Migration to marlev.com remains a separate future step.
  "name": "marlev-site-preview",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "routes": [{ "pattern": "marlev.countinglight.com", "custom_domain": true }],
  "previews": {},
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
